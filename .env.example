# Copy to .env and fill in values. Never commit .env.
# docker compose sets DATABASE_URL and REDIS_URL for containers automatically; the values
# below are for running the backend directly on your machine.

# --- Core (Phase 1) ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://socialpilot:socialpilot@localhost:5432/socialpilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173

# docker-compose.yml: local Postgres credentials and host ports (change ports on conflict)
POSTGRES_USER=socialpilot
POSTGRES_PASSWORD=socialpilot
POSTGRES_DB=socialpilot
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Firebase web app config (frontend; public identifiers, not secrets) ---
# Firebase Console > Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Admin (backend only; SECRET) ---
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Keep the PEM on one line with literal \n sequences, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Instagram API with Instagram Login (backend only) ---
# Meta App Dashboard > your app > Instagram > API setup with Instagram login.
# Use the *Instagram* app ID and secret shown there (not the Facebook app ID).
META_APP_ID=
# SECRET. Also used to verify webhook signatures (X-Hub-Signature-256).
META_APP_SECRET=
# Must exactly match a redirect URL registered in the dashboard; must be HTTPS and reach
# /api/instagram/callback on the same origin the browser uses for the app.
META_REDIRECT_URI=
# SECRET. Any random string; enter the same value as the webhook "Verify token" in the dashboard.
META_WEBHOOK_VERIFY_TOKEN=
# Check these against Meta's current docs; defaults are in backend/app/core/config.py.
# META_API_VERSION=v23.0
# META_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
# META_WEBHOOK_FIELDS=comments,messages

# SECRET. Encrypts stored Instagram access tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate keys to rotate: the first encrypts, all decrypt.
TOKEN_ENCRYPTION_KEYS=

# Browser origin of the app; OAuth callbacks redirect here.
FRONTEND_URL=http://localhost:5173
# Extra hostnames the Vite dev server accepts, e.g. an HTTPS tunnel used for Meta testing.
VITE_ALLOWED_HOSTS=

# --- AI (Phase 5, backend only) ---
# mock: deterministic drafts, no network. gemini: Google Gen AI SDK. Without a key the
# API still starts and AI routes return AI_NOT_CONFIGURED.
AI_PROVIDER=gemini
# SECRET. Never put this in frontend env (no VITE_ prefix).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# AI_TEMPERATURE=0.4
# AI_MAX_OUTPUT_TOKENS=256
# AI_TIMEOUT_SECONDS=20
# AI_MAX_CONTEXT_MESSAGES=20
# AI_MEMORY_TOP_K=5
# AI_REQUESTS_PER_MINUTE=30

# --- Knowledge base (Phase 6, backend only) ---
# Local files. Not exposed to the frontend. Relative paths are resolved from the backend
# working directory.
# KNOWLEDGE_STORAGE_PATH=storage/knowledge
# KNOWLEDGE_MAX_FILE_SIZE_MB=10
# KNOWLEDGE_CHUNK_SIZE=600
# KNOWLEDGE_CHUNK_OVERLAP=80
# KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
# Cosine distance cutoff. 0 is an identical vector. Higher values allow weaker matches.
# KNOWLEDGE_RETRIEVAL_TOP_K=5
# KNOWLEDGE_RETRIEVAL_MAX_DISTANCE=0.5
